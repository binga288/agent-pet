{
  "name": "agent-pet",
  "productName": "Agent Pet",
  "version": "0.1.1",
  "description": "A quiet desktop companion for AI agent activity",
  "author": "Akita",
  "license": "UNLICENSED",
  "private": true,
  "engines": { "node": ">=24.16.0" },
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "typecheck": "tsc --noEmit",
    "build:relay": "node scripts/build-relay.mjs",
    "package": "npm run build:relay && electron-forge package",
    "make": "npm run build:relay && electron-forge make",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/shared-types": "^7.11.2",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^44.3.0",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^7.0.2",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "overrides": {
    "@electron/packager": {
      "extract-zip": "npm:@electron-internal/extract-zip@1.0.5"
    }
  }
}
